# ==============================================================================
# IncidentLens AI - Backend Configuration (.env.example)
# Copy this file to .env and adjust variables as needed.
# ==============================================================================

# Application Settings
APP_NAME=IncidentLens AI
VERSION=1.0.0
DEBUG=false

# CORS Configuration
FRONTEND_ORIGIN=http://localhost:5173

# AI Provider ("local" for zero-dependency simulation, or "bedrock" for Amazon Bedrock)
AI_PROVIDER=local

# AWS & Amazon Bedrock Configuration (required only when AI_PROVIDER=bedrock)
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0

# AWS S3 Postmortem Archival (Optional)
S3_BUCKET=
S3_REPORTS_PREFIX=incidentlens/reports/

# AWS Credentials (Optional: prefer IAM Roles / AWS CLI credentials profile in production)
# AWS_ACCESS_KEY_ID=your_access_key_here
# AWS_SECRET_ACCESS_KEY=your_secret_key_here
